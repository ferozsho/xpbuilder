+            />
+            <Button
+              size="small"
+              type="text"
+              icon={<Icons.CloseOutlined />}
+              onClick={() => onRemoveMetric(index)}
+            />
+          </StyledChip>
+        ))}
+      </DropBand>
+    </Space>
+  );
+}
