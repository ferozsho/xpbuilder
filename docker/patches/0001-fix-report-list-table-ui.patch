+                onUpdateMetric(index, {
+                  ...metric,
+                  aggregate,
+                  label: `${aggregate}(${metric.column})`,
+                })
+              }
+            />
+            <Input
+              size="small"
+              defaultValue={metric.label}
+              style={{ width: 140 }}
+              onBlur={event =>
+                onUpdateMetric(index, { ...metric, label: event.target.value })
